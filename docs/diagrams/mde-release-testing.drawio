        <mxCell id="c37" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="c7" vertex="1">
