        <mxCell id="c18" value="" style="image;aspect=fixed;html=1;points=[];fontSize=12;image=img/lib/azure2/networking/Virtual_Networks.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;whiteSpace=wrap;labelWidth=160;" parent="c17" vertex="1">
