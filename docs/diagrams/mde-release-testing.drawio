        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;the libre-devops/terraform-azure action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="c6" vertex="1">
          <mxGeometry x="20" y="320" width="300" height="60" as="geometry" />
