          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="The pipeline: one Terraform apply, about 40 minutes, nothing left running afterwards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#1E3A8A;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;container=1;collapsible=0;arcSize=3;" parent="1" vertex="1">
