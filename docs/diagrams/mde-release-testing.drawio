          <mxGeometry x="40" y="140" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;packages.microsoft.com&lt;/b&gt;&lt;br&gt;rhel/7, 8 and 9/prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="c4" vertex="1">
          <mxGeometry x="20" y="40" width="300" height="60" as="geometry" />
