        <mxCell id="c2" value="stacks/mde-rhel-offline: what is in Azure" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1E3A8A;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="A RHEL VM that can reach nothing, reached only through a bastion that exists for the length of one apply." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#4D4D4D;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="62" width="1500" height="40" as="geometry" />
