        <mxCell id="c17" value="Virtual network 10.30.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;arcSize=3;" parent="c15" vertex="1">
