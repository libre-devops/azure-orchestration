        <mxCell id="c19" value="AzureBastionSubnet 10.30.0.0/26" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;container=1;collapsible=0;arcSize=3;dashed=1;dashPattern=8 4;" parent="c17" vertex="1">
          <mxGeometry x="20" y="50" width="320" height="430" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Public IP" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/networking/Public_IP_Addresses.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;whiteSpace=wrap;labelWidth=100;" parent="c19" vertex="1">
          <mxGeometry x="30" y="100" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b&gt;Azure Bastion&lt;/b&gt; (Standard)&lt;br&gt;native client tunnelling" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/networking/Bastions.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;whiteSpace=wrap;labelWidth=150;" parent="c19" vertex="1">
          <mxGeometry x="200" y="100" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c20" target="c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;i&gt;Dashed: created and deleted by the bastion-session module inside the apply. It exists only while Ansible runs.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" parent="c19" vertex="1">
          <mxGeometry x="20" y="330" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="snet-vm 10.30.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;container=1;collapsible=0;arcSize=3;" parent="c17" vertex="1">
          <mxGeometry x="360" y="50" width="330" height="430" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;NSG&lt;/b&gt;: SSH 22 from the bastion subnet only" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/networking/Network_Security_Groups.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;labelWidth=250;" parent="c24" vertex="1">
          <mxGeometry x="20" y="40" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;RHEL 7, 8 and 9 VMs&lt;/b&gt;&lt;br&gt;no public IP, no NAT,&lt;br&gt;no default outbound access" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/compute/Virtual_Machine.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;whiteSpace=wrap;labelWidth=200;" parent="c24" vertex="1">
          <mxGeometry x="110" y="100" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="Defender for Endpoint, installed and tested" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/security/Azure_Defender.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;labelWidth=240;" parent="c24" vertex="1">
          <mxGeometry x="20" y="270" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="No route to the internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;arcSize=12;fontStyle=1;" parent="c24" vertex="1">
          <mxGeometry x="20" y="350" width="290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;Key Vault&lt;/b&gt;: the admin SSH key. Deny by default; the runner's IP is let in for the run. Access policies by exception (RBAC way in main.tf)." style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/security/Key_Vaults.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;labelWidth=420;" parent="c15" vertex="1">
          <mxGeometry x="40" y="600" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;b&gt;Entra ID app registration&lt;/b&gt;: OIDC federated credential, no secrets" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/identity/App_Registrations.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;labelWidth=420;" parent="c14" vertex="1">
          <mxGeometry x="40" y="820" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;b&gt;Terraform state&lt;/b&gt;: a storage account, firewalled" style="image;aspect=fixed;html=1;points=[];fontSize=11;image=img/lib/azure2/storage/Storage_Accounts.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;labelWidth=420;" parent="c14" vertex="1">
          <mxGeometry x="40" y="890" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="2. SSH, tunnelled over HTTPS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c9" target="c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="3. SSH 22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c21" target="c26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="fetch the key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c9" target="c29">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="405" y="481" />
              <mxPoint x="405" y="816" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c35" value="sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0078D4;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c11" target="c30">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="984" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;Why this shape&lt;/b&gt;&lt;br&gt;No VPN, no self-hosted runner, no inbound rule from the internet. The bastion, its IP and any sign-in role exist for minutes, inside one apply. An always() step and an hourly sweeper remove anything a failed run leaves." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="140" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="&lt;b&gt;Offline on purpose&lt;/b&gt;&lt;br&gt;The VM reaches nothing, so the test proves the release installs and protects from the RPM alone. Cloud-delivered protection is off: with it on and no route out, each detection waited 40 s for the cloud." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="320" width="350" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
