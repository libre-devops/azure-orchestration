        <mxCell id="c24" value="A Python Ansible can use goes to RHEL 7 and 8; the RPM is pushed through the bastion and installed from the file alone, its signature checked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c7" vertex="1">
