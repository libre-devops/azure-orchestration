        <mxCell id="c10" value="&lt;b&gt;Test report&lt;/b&gt;&lt;br&gt;HTML, JSON, JUnit and evidence, uploaded as an artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="c6" vertex="1">
