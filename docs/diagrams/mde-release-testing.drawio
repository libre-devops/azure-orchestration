        <mxCell id="c39" value="Times from pipeline run 43958570981 (UK South, 16 November 2026), RHEL 7, 8 and 9 in parallel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="40" y="440" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c40" value="If something fails part way" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;container=1;collapsible=0;arcSize=3;" parent="1" vertex="1">
          <mxGeometry x="40" y="500" width="1570" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;open.sh fails&lt;/b&gt;&lt;br&gt;It closes what it created itself: Terraform skips destroy-time steps for a failed resource." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c40" vertex="1">
          <mxGeometry x="20" y="50" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c42" value="&lt;b&gt;A role fails&lt;/b&gt;&lt;br&gt;Terraform skips the close step, so the workflow's always() step runs close.sh from the session's own file, without Terraform state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c40" vertex="1">
          <mxGeometry x="400" y="50" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="&lt;b&gt;The runner is lost&lt;/b&gt;&lt;br&gt;An hourly sweeper finds anything tagged BastionSession=mde-rhel-offline and closes it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c40" vertex="1">
          <mxGeometry x="820" y="50" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="&lt;b&gt;Whatever was written comes back&lt;/b&gt;&lt;br&gt;An always() step uploads test-results/, so a failed run still returns its report and evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c40" vertex="1">
          <mxGeometry x="1200" y="50" width="350" height="100" as="geometry" />
        </mxCell>
