        <mxCell id="c42" value="Test VMs, one per RHEL release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=11;container=1;collapsible=0;arcSize=3;" parent="c7" vertex="1">
