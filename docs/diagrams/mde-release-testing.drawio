        <mxCell id="c40" value="bastion-session&lt;br&gt;Terraform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="c7" vertex="1">
