        <mxCell id="c43" value="RHEL 7" style="image;aspect=fixed;html=1;points=[];fontSize=10;image=img/lib/azure2/compute/Virtual_Machine.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;whiteSpace=wrap;labelWidth=60;" parent="c42" vertex="1">
          <mxGeometry x="14" y="30" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="RHEL 8" style="image;aspect=fixed;html=1;points=[];fontSize=10;image=img/lib/azure2/compute/Virtual_Machine.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;whiteSpace=wrap;labelWidth=60;" parent="c42" vertex="1">
          <mxGeometry x="76" y="30" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="RHEL 9" style="image;aspect=fixed;html=1;points=[];fontSize=10;image=img/lib/azure2/compute/Virtual_Machine.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;whiteSpace=wrap;labelWidth=60;" parent="c42" vertex="1">
          <mxGeometry x="138" y="30" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="&lt;i&gt;Roles in purple are libre_devops Ansible roles, run from Terraform through the bastion.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" parent="c7" vertex="1">
          <mxGeometry x="20" y="420" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="People" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBF0;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;container=1;collapsible=0;arcSize=3;" parent="1" vertex="1">
          <mxGeometry x="40" y="740" width="1570" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;Review&lt;/b&gt;&lt;br&gt;Read the report: what failed, why, what to do. Waive what is accepted, with a reason and an expiry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c47" vertex="1">
          <mxGeometry x="20" y="45" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="&lt;b&gt;Approve and publish&lt;/b&gt;&lt;br&gt;Promote the release (at work: to the production Satellite content view)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c47" vertex="1">
          <mxGeometry x="420" y="45" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1E3A8A;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c48" target="c49">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c51" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#d6b656;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="c47" vertex="1">
          <mxGeometry x="-10" y="30" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c52" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#FFFFFF;fontStyle=1;fontSize=14;" parent="c47" vertex="1">
          <mxGeometry x="400" y="30" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c53" value="&lt;b&gt;What the pipeline replaces&lt;/b&gt;&lt;br&gt;Building a VM, subscribing it, installing the release, checking it by hand, destroying it: the same every month, now in one run, with evidence." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="c47" vertex="1">
          <mxGeometry x="800" y="40" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c54" value="&lt;b&gt;What stays with people&lt;/b&gt;&lt;br&gt;Judgement: reading the report and deciding to release. Everything up to that point is repeatable and recorded." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="c47" vertex="1">
          <mxGeometry x="1190" y="40" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c55" value="test-results.html, for people" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1E3A8A;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c35" target="c48">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1268" y="725" />
              <mxPoint x="240" y="725" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c56" value="&lt;b&gt;The matrix&lt;/b&gt;&lt;br&gt;One VM per release in rhel_releases (7, 8 and 9 by default), in the same apply and the same report. RHEL 7 and 8 get a newer Python pushed (libre_devops.python); RHEL 7 installs with yum and runs on a SCSI size. All three pass live." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1190" y="960" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c57" value="&lt;b&gt;Measured&lt;/b&gt; (16 November 2026, run 43958570981, mdatp 101.26101.0000): RHEL 7.9, 8.10 and 9.8 each 44 checks passed, 11 skipped with reasons; EICAR detected in 0.39 to 0.42 s; protection back after every reboot." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="960" width="520" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Azure architecture" id="azure-architecture">
