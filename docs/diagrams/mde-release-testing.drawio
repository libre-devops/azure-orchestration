        <mxCell id="c38" value="&lt;b&gt;Close&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="c7" vertex="1">
          <mxGeometry x="1388" y="45" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c39" value="The bastion is deleted. End-to-end runs destroy the VMs too: nothing left billing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=6;arcSize=12;" parent="c7" vertex="1">
