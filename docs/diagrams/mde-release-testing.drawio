        <mxCell id="c2" value="Testing a Defender for Endpoint release, automatically" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;fontColor=#1E3A8A;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="One pipeline run builds the test machines, installs the release, tests it and reports. People read the report and decide." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#4D4D4D;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="62" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;New mdatp release&lt;/b&gt;&lt;br&gt;or run by hand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="140" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;the mde-rhel-offline-deploy workflow" style="image;aspect=fixed;html=1;points=[];fontSize=12;image=images/github-logo.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;whiteSpace=wrap;labelWidth=260;" parent="1" vertex="1">
